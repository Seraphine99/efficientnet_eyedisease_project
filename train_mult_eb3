import tensorflow as tf
from tensorflow.keras import layers, models, regularizers
from tensorflow.keras.applications import EfficientNetB3
from tensorflow.keras.preprocessing.image import ImageDataGenerator
from tensorflow.keras.applications.efficientnet import preprocess_input
import matplotlib.pyplot as plt
import os

# --- 1. CONFIGURATION ---
IMG_SIZE = (300, 300)  # B3 requirement
BATCH_SIZE = 20        # Reduced slightly because B3 uses more VRAM/Memory
EPOCHS = 20
DATA_DIR = 'dataset_fundus'

# --- 2. DATA PREPARATION ---
train_datagen = ImageDataGenerator(
    preprocessing_function=preprocess_input,
    rotation_range=20,
    width_shift_range=0.2,
    height_shift_range=0.2,
    zoom_range=0.2,
    horizontal_flip=True,
    fill_mode='nearest'
)

val_datagen = ImageDataGenerator(preprocessing_function=preprocess_input)

train_gen = train_datagen.flow_from_directory(
    os.path.join(DATA_DIR, 'train'),
    target_size=IMG_SIZE,
    batch_size=BATCH_SIZE,
    class_mode='categorical'
)

val_gen = val_datagen.flow_from_directory(
    os.path.join(DATA_DIR, 'test'), # or 'val' if you have it
    target_size=IMG_SIZE,
    batch_size=BATCH_SIZE,
    class_mode='categorical',
    shuffle=False
)

# --- 3. MODEL ARCHITECTURE (B3 Upgrade) ---
print("🚀 Building EfficientNet-B3 Model...")
conv_base = EfficientNetB3(weights='imagenet', include_top=False, input_shape=(300, 300, 3))
conv_base.trainable = False  # Start by freezing the base

model = models.Sequential([
    conv_base,
    layers.GlobalAveragePooling2D(),
    layers.BatchNormalization(),
    layers.Dropout(0.4), # Increased dropout for B3's complexity
    layers.Dense(256, activation='relu', kernel_regularizer=regularizers.l2(0.01)),
    layers.Dense(4, activation='softmax')
])

model.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['accuracy'])

# --- 4. TRAINING ---
print("📂 Starting Training Phase...")
history = model.fit(
    train_gen,
    validation_data=val_gen,
    epochs=EPOCHS
)

# --- 5. SAVING MODEL & PLOTTING ---
model.save('eye_model_b3.keras')
print("✅ Model Saved as eye_model_b3.keras")

# --- 6. GENERATE & SAVE GRAPHS ---
def plot_and_save_history(history):
    acc = history.history['accuracy']
    val_acc = history.history['val_accuracy']
    loss = history.history['loss']
    val_loss = history.history['val_loss']
    epochs_range = range(1, len(acc) + 1)

    plt.figure(figsize=(12, 5))

    # Plot Accuracy
    plt.subplot(1, 2, 1)
    plt.plot(epochs_range, acc, label='Training Accuracy')
    plt.plot(epochs_range, val_acc, label='Validation Accuracy')
    plt.title('Training and Validation Accuracy (B3)')
    plt.legend(loc='lower right')
    plt.grid(True)

    # Plot Loss
    plt.subplot(1, 2, 2)
    plt.plot(epochs_range, loss, label='Training Loss')
    plt.plot(epochs_range, val_loss, label='Validation Loss')
    plt.title('Training and Validation Loss (B3)')
    plt.legend(loc='upper right')
    plt.grid(True)

    plt.tight_layout()
    plt.savefig('training_report_b3.png')
    plt.show()
    print("📈 Graphs saved as training_report_b3.png")

plot_and_save_history(history)